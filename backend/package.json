{
  "scripts": {
    "start": "source .env.local && export $(cat .env.local | grep -v '^#' | xargs) && serverless offline start",
    "start:local": "DYNAMODB_ENDPOINT=http://localhost:8000 serverless offline start",
    "import-data": "curl -X POST http://localhost:3000/dev/import-data",
    "setup": "npm install && serverless dynamodb install"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.3.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^8.0.4"
  },
  "devDependencies": {
    "serverless-dynamodb": "^0.2.56",
    "serverless-offline": "^13.8.0",
    "serverless-s3-sync": "^3.3.0"
  }
}
